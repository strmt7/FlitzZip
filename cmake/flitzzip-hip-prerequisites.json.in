[
    {
      "name": "AMD GPU driver with HIP-capable runtime support",
      "installed_by_flitzzip": false,
      "required_runtime_dll": "@FLITZZIP_HIP_RUNTIME_DLL_NAME@",
      "build_sdk_runtime_sha256": "@FLITZZIP_HIP_RUNTIME_DLL_SHA256@",
      "build_sdk_runtime_size_bytes": @FLITZZIP_HIP_RUNTIME_DLL_SIZE@,
      "reason": "AMD documents the HIP runtime as supplied by the AMD GPU driver. FlitzZip delay-loads this runtime so the app and installer can report missing prerequisites cleanly."
    }
